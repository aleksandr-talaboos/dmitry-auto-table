# off | dry-run | write (default dry-run: compute and return CSV, never touch the sheet)
LIBRARY_MODE=
# First day of the lifetime window, YYYY-MM-DD (default 2026-06-01)
LIBRARY_FROM=
# Max Binom requests per run (default 80; a warm run uses ~15, the first cold run ~60)
LIBRARY_REQUEST_BUDGET=
# Campaign IDs per lifetime-days and paid query, 1-10 (default 4)
LIBRARY_DAYS_CHUNK=
# JSON campaign ID -> label (default {"14":"E011","15":"E012","16":"E014"})
LIBRARY_ALIASES=
# Google spreadsheet ID; required for write mode
LIBRARY_SPREADSHEET_ID=
# Optional existing tab gid; overrides the title
LIBRARY_SHEET_GID=
# Tab title, created on the first write if absent (default "Драфт отчета по всем тестам - авто (Vercel)")
LIBRARY_SHEET_TITLE=
# true creates one dated archive copy of the selected tab (default false)
LIBRARY_ARCHIVE=
# Registry tab with E-numbers in column A and names in column B (default Тесты)
LIBRARY_REGISTRY_TAB=
# JSON product or offer ID -> trial-to-paid lag days (default {"IQ":10,"Zodeya":16,"Subcaddy":14,"34":19}; 14 for others)
LIBRARY_PAID_LAG_DAYS=
# Comma-separated campaignId:offerId control overrides, e.g. 101:7,202:9
LIBRARY_BASE_OFFER_OVERRIDES=
# true allows writing the protected tabs 1514034458 and 1991356788 (default false)
LIBRARY_ALLOW_PROTECTED_TAB=
# Binom HTTPS origin, e.g. https://binom.example.com (required unless LIBRARY_MODE=off)
BINOM_BASE_URL=
# Binom API key, at least 20 characters (required unless LIBRARY_MODE=off)
BINOM_API_KEY=
# CampaignsWell MCP server for `npm run cw:login` only (default https://mcp.campaignswell.com);
# the function uses the server stored with the token
CW_SERVER_URL=
# true never refreshes the CW token; an expired token then leaves CW cells empty (default false)
CW_REFRESH_DISABLED=
# Service account key JSON, raw or base64; required for write mode
GOOGLE_SERVICE_ACCOUNT_JSON=
# Bearer secret for /api/run, at least 32 characters; Vercel Cron sends it automatically when set
CRON_SECRET=
# Seconds after which a run stops itself and releases its lock; keep it ~30 s below maxDuration in vercel.json
# (default 270 for maxDuration 300)
LIBRARY_DEADLINE_SECONDS=
# Optional Slack-compatible incoming webhook (https://...): failed runs and final passes without CW are posted there
LIBRARY_ALERT_WEBHOOK_URL=
# Upstash Redis REST endpoint and token (local runs fall back to .state/ when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Same store under the names injected by the Vercel Marketplace Upstash integration
KV_REST_API_URL=
KV_REST_API_TOKEN=
